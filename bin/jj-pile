#!/usr/bin/env python3
"""Publish individual jj changes as GitHub pull requests."""

import argparse
import json
import re
import subprocess
import sys
from urllib.parse import urlsplit


def run(*args):
    return subprocess.run(args, text=True, capture_output=True, check=True).stdout


def jj(*args):
    return run("jj", "--no-pager", "--color=never", *args)


def fail(message):
    raise SystemExit("error: " + message)


def changes(revset):
    template = (
        'commit_id ++ "\\t" ++ change_id ++ "\\t" ++ conflict ++ "\\t" '
        '++ empty ++ "\\t" ++ json(description) ++ "\\n"'
    )
    result = []
    for line in jj("log", "--no-graph", "-r", revset, "-T", template).splitlines():
        commit, change, conflict, empty, description = line.split("\t", 4)
        result.append(
            {
                "commit": commit,
                "change": change,
                "conflict": conflict == "true",
                "empty": empty == "true",
                "description": json.loads(description),
            }
        )
    return result


def one(revset):
    result = changes(revset)
    if len(result) != 1:
        fail(f"expected exactly one revision for {revset!r}, found {len(result)}")
    return result[0]


def bookmark(change):
    # Full change IDs survive rewrites and description edits without a state file.
    return "pile/" + change["change"]


def remote_ref(name, remote):
    return f"remote_bookmarks(exact:{json.dumps(name)}, exact:{json.dumps(remote)})"


def repo_from_url(url):
    if "://" not in url:
        match = re.fullmatch(r"(?:[^@/]+@)?([^:/]+):(.+)", url)
        if not match:
            fail(
                "cannot infer GitHub repository from remote URL; pass --repo OWNER/REPO"
            )
        url = f"ssh://{match[1]}/{match[2]}"
    parsed = urlsplit(url)
    path = parsed.path.strip("/").removesuffix(".git")
    if not parsed.hostname or len(path.split("/")) != 2:
        fail("cannot infer GitHub repository from remote URL; pass --repo OWNER/REPO")
    return f"{parsed.hostname}/{path}"


class GitHub:
    def __init__(self, options):
        remotes = dict(
            line.split(maxsplit=1) for line in jj("git", "remote", "list").splitlines()
        )
        self.remote = options.remote or "origin"
        if self.remote not in remotes:
            fail(f"no jj Git remote named {self.remote!r}")
        # Match git-pile: origin (or an explicit --remote) identifies the PR
        # repository, while a conventional `mine` remote is preferred for pushes.
        self.push_remote = (
            "mine" if options.remote is None and "mine" in remotes else self.remote
        )
        self.repo = options.repo or repo_from_url(remotes[self.remote])
        self.head_owner = None
        if self.push_remote != self.remote:
            try:
                push_repo = repo_from_url(remotes[self.push_remote])
                if push_repo != repo_from_url(remotes[self.remote]):
                    self.head_owner = push_repo.rsplit("/", 2)[-2]
            except SystemExit:
                # Local/file remotes are useful in tests and do not need a
                # fork-qualified GitHub head.
                pass

    def head(self, branch):
        return f"{self.head_owner}:{branch}" if self.head_owner else branch

    def gh(self, *args):
        return run("gh", *args, "--repo", self.repo)

    def find(self, branch):
        # `gh pr list --head` only accepts an unqualified branch name. Filter
        # the returned candidates by owner when pushing from a fork.
        prs = json.loads(
            self.gh(
                "pr",
                "list",
                "--head",
                branch,
                "--state",
                "all",
                "--limit",
                "100",
                "--json",
                "url,state,baseRefName,headRepositoryOwner",
            )
        )
        if self.head_owner:
            prs = [
                pr
                for pr in prs
                if not pr.get("headRepositoryOwner")
                or pr["headRepositoryOwner"].get("login") == self.head_owner
            ]
        opened = [pr for pr in prs if pr["state"] == "OPEN"]
        if len(opened) > 1:
            fail(f"multiple open PRs for {branch}")
        return opened[0] if opened else (prs[0] if prs else None)

    def require_open(self, branch):
        pr = self.find(branch)
        if not pr or pr["state"] != "OPEN":
            fail(f"no open PR for {branch}; use submit for a new change")
        return pr

    def default_base(self):
        # Unlike `gh pr`, `gh repo view` takes the repository positionally.
        result = json.loads(
            run("gh", "repo", "view", self.repo, "--json", "defaultBranchRef")
        )
        if not result.get("defaultBranchRef"):
            fail("GitHub repository has no default branch; pass --base")
        return result["defaultBranchRef"]["name"]


def local_ref(name):
    return f"bookmarks(exact:{json.dumps(name)})"


def published_bookmark(change, remote):
    return f"pile-published/{remote}/{change['change']}"


def validate(change, remote):
    if change["conflict"] or change["empty"] or not change["description"].strip():
        fail(
            "publish a nonempty, described, conflict-free change (use jj describe / jj resolve)"
        )
    if len(changes(f"parents({change['commit']})")) != 1:
        fail(
            "integration merges are local testing changes; submit their individual parents"
        )
    private = jj("config", "get", "git.private-commits").strip()
    if changes(f"({private}) & {change['commit']}"):
        fail(
            "the selected change is private; adjust git.private-commits before publishing"
        )
    branch = bookmark(change)
    refs = changes(local_ref(branch))
    published = changes(local_ref(published_bookmark(change, remote)))
    fetched = changes(remote_ref(branch, remote))
    if published:
        if len(published) != 1 or refs != published or fetched != published:
            fail(
                "the review branch has changed since the last publication; inspect remote edits "
                "and resolve the review bookmark before retrying (see jj-pile recovery docs)"
            )
    else:
        # Adopt reviews made by older jj-pile versions only when their heads
        # still identify the original change. A remote auto-fix has another ID.
        if (
            any(item["change"] != change["change"] for item in refs + fetched)
            or len(refs) > 1
        ):
            fail(
                "the review bookmark has moved or is conflicted; inspect it before publishing"
            )
    return refs


def project(change, base):
    # Duplicate gives the publication its own identity, so source rewrites do
    # not move the review bookmark or rebase published descendants.
    operation = jj("op", "log", "--no-graph", "--limit", "1", "-T", "id").strip()
    jj(
        "--config",
        'templates.duplicate_description="description"',
        "duplicate",
        change["commit"],
        "--onto",
        base["commit"],
    )
    result = one(f"all() ~ at_operation({operation}, all())")
    if result["conflict"] or result["empty"]:
        jj("abandon", result["commit"])
        fail(
            "the change conflicts with the PR base or is empty on that base; "
            "resolve the source change or declare its dependency with --onto"
        )
    return result


def publish(change, base, remote):
    previous = validate(change, remote)
    projected = project(change, base)
    branch = bookmark(change)
    jj("bookmark", "set", branch, "-r", projected["commit"], "--allow-backwards")
    try:
        # Older jj versions require explicit tracking even with --bookmark.
        jj("bookmark", "track", f"{branch}@{remote}")
        # Keep jj's remote lease and private-change checks. Never fetch here.
        output = jj("git", "push", "--remote", remote, "--bookmark", branch)
    except (subprocess.CalledProcessError, KeyboardInterrupt):
        if previous:
            jj(
                "bookmark",
                "set",
                branch,
                "-r",
                previous[0]["commit"],
                "--allow-backwards",
            )
        else:
            jj("bookmark", "delete", branch)
        raise
    jj(
        "bookmark",
        "set",
        published_bookmark(change, remote),
        "-r",
        projected["commit"],
        "--allow-backwards",
    )
    if output:
        print(output, end="")


def main():
    parser = argparse.ArgumentParser(prog="jj pile", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    for name in ("submit", "update", "open", "status"):
        command = sub.add_parser(name)
        command.add_argument(
            "-r",
            "--revision",
            default="trunk()..@" if name == "status" else None,
            help="jj revset (default: @; submit: parent of an empty, undescribed @; "
            "status: trunk()..@)",
        )
        command.add_argument(
            "--remote",
            help="upstream and push remote (default: origin, pushing to mine if present)",
        )
        command.add_argument(
            "--repo", help="GitHub OWNER/REPO or URL (default: remote URL)"
        )
        if name == "submit":
            base = command.add_mutually_exclusive_group()
            base.add_argument(
                "--base", help="base branch (default: GitHub default branch)"
            )
            base.add_argument(
                "--onto", help="explicit dependency: change with an open PR"
            )
            command.add_argument("--draft", action="store_true")
    # Treat the top-level command as the status overview. This keeps the
    # convenient `jj pile` alias useful without requiring a redundant command.
    options = parser.parse_args(sys.argv[1:] or ["status"])
    github = GitHub(options)
    if options.command == "status":
        for change in changes(options.revision):
            pr = github.find(bookmark(change))
            state = pr["state"].lower() if pr else "unsubmitted"
            title = change["description"].splitlines()
            print(
                change["change"][:12],
                state,
                title[0] if title else "(no description)",
                pr["url"] if pr else "",
            )
        return
    revision = options.revision or "@"
    change = one(revision)
    if (
        options.command == "submit"
        and options.revision is None
        and change["empty"]
        and not change["description"].strip()
    ):
        change = one(f"parents({change['commit']})")
    branch = bookmark(change)
    if options.command == "open":
        pr = github.find(branch)
        if not pr:
            fail(f"no PR for {branch}")
        github.gh("pr", "view", pr["url"], "--web")
        return
    if options.command == "update":
        pr = github.require_open(branch)
        base_remote = (
            github.push_remote
            if pr["baseRefName"].startswith("pile/")
            else github.remote
        )
        base = one(remote_ref(pr["baseRefName"], base_remote))
        publish(change, base, github.push_remote)
        print(pr["url"])
        return
    existing = github.find(branch)
    if existing:
        if existing["state"] == "OPEN":
            print(existing["url"])
            return
        fail("this change already has a closed or merged PR; create a new jj change")
    if options.onto:
        parent = one(options.onto)
        if parent["change"] == change["change"]:
            fail("a change cannot depend on itself")
        base = bookmark(parent)
        github.require_open(base)
        base_remote = github.push_remote
    else:
        base = options.base or github.default_base()
        base_remote = github.remote
    publish(change, one(remote_ref(base, base_remote)), github.push_remote)
    title, _, body = change["description"].strip().partition("\n")
    print(
        github.gh(
            "pr",
            "create",
            "--head",
            github.head(branch),
            "--base",
            base,
            "--title",
            title,
            "--body",
            body.strip(),
            *(["--draft"] if options.draft else []),
        ).strip()
    )


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        print(error.stderr or str(error), file=sys.stderr, end="\n")
        raise SystemExit(error.returncode) from None
    except (OSError, ValueError) as error:
        fail(str(error))
    except KeyboardInterrupt:
        raise SystemExit(130) from None
